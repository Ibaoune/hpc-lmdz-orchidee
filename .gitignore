# ==============================================================================
# Git Ignore for IPSL / modipsl Toubkal Repository
# Author: M. El Aabaribaoune (UM6P)
# ==============================================================================

# Compiled binaries and libraries
*.a
*.o
*.mod
*.exe
*.so

# Top-level compiled outputs (keep .gitkeep files)
/bin/*
!/bin/.gitkeep
/lib/*
!/lib/.gitkeep

# Subversion directories
.svn/
**/.svn/**

# FCM and build artifacts
.fcm/
*.bld
*.done
*.log
*~
*.swp
.DS_Store

# Large datasets & simulation outputs
*.nc
*.nc4
*.nc.gz
*.tar
*.tar.gz
*.zip
Script_Output_*
IGCM_OUT/
run_dir*/
test_run*/
work/

# Python cache
__pycache__/
*.pyc

# IDE & temporary directories
.system_generated/
scratch/

# Test simulation working directories
simulations/

# Upstream config directory (exclude all except Toubkal arch files)
config/*
!config/LMDZOR_v6/
config/LMDZOR_v6/*
!config/LMDZOR_v6/ARCH/
config/LMDZOR_v6/ARCH/*
!config/LMDZOR_v6/ARCH/arch-X64_TOUBKAL.*

# External upstream IPSL framework (SVN checkouts not used in offline benchmark)
libIGCM/
doc/
util/

# Coupled model LMDZ (not part of standalone ORCHIDEE offline)
modeles/LMDZ/*
!modeles/LMDZ/arch/
modeles/LMDZ/arch/*
!modeles/LMDZ/arch/arch-X64_TOUBKAL.*

# Generated compilation products inside modeles/
# IOIPSL generated artifacts
modeles/IOIPSL/build/
modeles/IOIPSL/bin/
modeles/IOIPSL/lib
modeles/IOIPSL/inc
modeles/IOIPSL/arch.env
modeles/IOIPSL/arch.fcm
modeles/IOIPSL/arch.path

# XIOS generated artifacts and caches
modeles/XIOS/obj/
modeles/XIOS/ppsrc/
modeles/XIOS/flags/
modeles/XIOS/done/
modeles/XIOS/cfg/
modeles/XIOS/inc/
modeles/XIOS/lib/
modeles/XIOS/bin/
modeles/XIOS/.cache/
modeles/XIOS/tmp/
modeles/XIOS/Makefile
modeles/XIOS/bld_dir.cfg
modeles/XIOS/config.fcm
modeles/XIOS/fcm_env.sh
modeles/XIOS/fcm_env.ksh
modeles/XIOS/arch.env
modeles/XIOS/arch.fcm
modeles/XIOS/arch.path
modeles/XIOS/extern/netcdf4
modeles/XIOS/inc_gcc7_backup/
modeles/XIOS/lib_gcc7_backup/

# ORCHIDEE generated artifacts and caches
modeles/ORCHIDEE/build/
modeles/ORCHIDEE/build_*/
modeles/ORCHIDEE/bin
modeles/ORCHIDEE/bin_*
modeles/ORCHIDEE/lib
modeles/ORCHIDEE/inc
modeles/ORCHIDEE/arch.env
modeles/ORCHIDEE/arch.fcm
modeles/ORCHIDEE/arch.path
modeles/ORCHIDEE/config.fcm
modeles/ORCHIDEE/.cache/
modeles/ORCHIDEE/*.log
