# ==============================================================================
# Git Ignore for IPSL / modipsl Toubkal Repository
# Author: M. El Aabaribaoune (UM6P)
# ==============================================================================

# Compiled binaries and libraries
*.a
*.o
*.mod
*.exe
*.so
bin/*
lib/*
!bin/.gitkeep
!lib/.gitkeep

# External upstream IPSL framework & source trees (SVN checkouts)
libIGCM/
doc/
util/

# Upstream config directory (exclude all except Toubkal arch files)
config/*
!config/LMDZOR_v6/
config/LMDZOR_v6/*
!config/LMDZOR_v6/ARCH/
config/LMDZOR_v6/ARCH/*
!config/LMDZOR_v6/ARCH/arch-X64_TOUBKAL.*

# Modeles directory (exclude all except Toubkal arch files)
modeles/*

!modeles/ORCHIDEE/
modeles/ORCHIDEE/*
!modeles/ORCHIDEE/arch/
modeles/ORCHIDEE/arch/*
!modeles/ORCHIDEE/arch/arch-X64_TOUBKAL.*
!modeles/ORCHIDEE/arch/arch-X64_TOUBKAL_GCC12.*

!modeles/IOIPSL/
modeles/IOIPSL/*
!modeles/IOIPSL/arch/
modeles/IOIPSL/arch/*
!modeles/IOIPSL/arch/arch-X64_TOUBKAL.*

!modeles/XIOS/
modeles/XIOS/*
!modeles/XIOS/arch/
modeles/XIOS/arch/*
!modeles/XIOS/arch/arch-X64_TOUBKAL.*
!modeles/XIOS/arch/arch-X64_TOUBKAL_GCC12.*

!modeles/LMDZ/
modeles/LMDZ/*
!modeles/LMDZ/arch/
modeles/LMDZ/arch/*
!modeles/LMDZ/arch/arch-X64_TOUBKAL.*

# External large 3rd-party dependencies in XIOS
modeles/XIOS/extern/
modeles/XIOS/tools/

# Subversion directories
.svn/
**/.svn/**

# FCM and build artifacts
.fcm/
build/
*.bld
*.done
*.log
*~
*.swp
.DS_Store

# Large datasets & simulation outputs
*.nc
*.nc4
*.nc.gz
*.tar
*.tar.gz
*.zip
Script_Output_*
IGCM_OUT/
run_dir*/
test_run*/
work/

# Python cache
__pycache__/
*.pyc

# IDE & temporary directories
.system_generated/
scratch/

# Test simulation working directories
simulations/
