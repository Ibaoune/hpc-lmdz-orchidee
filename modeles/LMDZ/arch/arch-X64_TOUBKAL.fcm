# Author: M. El Aabaribaoune (UM6P)
# Affiliation: Mohammed VI Polytechnic University - IWRI Climate Team
# Contact: mohammad.elaabaribaoune@um6p.ma
%COMPILER            /srv/software/easybuild/software/OpenMPI/3.1.1-GCC-7.3.0-2.30/bin/mpif90
%LINK                /srv/software/easybuild/software/OpenMPI/3.1.1-GCC-7.3.0-2.30/bin/mpif90
%AR                  ar
%ARFLAGS          rs
%MAKE                make
%FPP_FLAGS           -P -traditional
%FPP_DEF             NC_DOUBLE FFT_FFTW
%BASE_FFLAGS          -cpp -ffree-line-length-0 -fdefault-real-8 -DNC_DOUBLE
%PROD_FFLAGS         -O3
%DEV_FFLAGS          -Wall -fbounds-check
%DEBUG_FFLAGS        -g3 -Wall -fbounds-check -ffpe-trap=invalid,zero,overflow -O0 -fstack-protector-all -fbacktrace -finit-real=snan
%MPI_FFLAGS          -fcray-pointer
%OMP_FFLAGS          -fopenmp -fcray-pointer
%BASE_LD             -lfftw3 -Wl,-rpath=/srv/software/easybuild/software/OpenMPI/3.1.1-GCC-7.3.0-2.30/lib:/srv/software/easybuild/software/netCDF-Fortran/4.4.4-foss-2018b/lib
%MPI_LD
%OMP_LD              -fopenmp
