NETCDF_LIBDIR="-L${EBROOTNETCDFMINFORTRAN}/lib -lnetcdff -L${EBROOTNETCDF}/lib -lnetcdf"
NETCDF_INCDIR="-I${EBROOTNETCDFMINFORTRAN}/include -I${EBROOTNETCDF}/include"

IOIPSL_INCDIR="-I${ORCHDIR}/../../lib -I${ORCHDIR}/../IOIPSL/inc"
IOIPSL_LIBDIR="-L${ORCHDIR}/../../lib -L${ORCHDIR}/../IOIPSL/lib"
IOIPSL_LIB="-lioipsl"

XIOS_INCDIR="-I${ORCHDIR}/../XIOS/inc"
XIOS_LIBDIR="-L${ORCHDIR}/../XIOS/lib"
XIOS_LIB="-lxios -lstdc++ -L${EBROOTHDF5}/lib -lhdf5_hl -lhdf5 -lz -lcurl"
