input=$@
paper=-p
quality=cx1800
debug=
flag_reference_file=0
group=GRA
config_ref=
config_eval=


mv ../stat_${config_eval}_${config_ref}_${group}_GPP_hour.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_GPP_day.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_GPP_month.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_GPP_year.csv .

mv ../stat_${config_eval}_${config_ref}_${group}_TER_hour.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_TER_day.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_TER_month.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_TER_year.csv .

mv ../stat_${config_eval}_${config_ref}_${group}_NEE_hour.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_NEE_day.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_NEE_month.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_NEE_year.csv .

mv ../stat_${config_eval}_${config_ref}_${group}_SH_hour.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_SH_day.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_SH_month.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_SH_year.csv .

mv ../stat_${config_eval}_${config_ref}_${group}_LH_hour.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_LH_day.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_LH_month.csv .
mv ../stat_${config_eval}_${config_ref}_${group}_LH_year.csv .


cp ../taylor_arrow_fluxnet_final_2.jnl .



# Ratio one day over time step
one_day=86400
ratio=$(( one_day/1800 ))

NumSites=`wc -l stat_${config_eval}_${config_ref}_${group}_GPP_hour.csv | sed -e "s/\([0-9]*\).*/\1/g"`
echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "hour-to-hour GPP variability" -o  gpp_hour taylor_arrow_fluxnet_final_2.jnl "${NumSites} hour $flag_reference_file GPP ${config_eval} ${config_ref} ${group}"

NumSites=`wc -l stat_${config_eval}_${config_ref}_${group}_GPP_day.csv | sed -e "s/\([0-9]*\).*/\1/g"`
echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "day-to-day GPP variability" -o  gpp_day taylor_arrow_fluxnet_final_2.jnl "${NumSites} day $flag_reference_file GPP ${config_eval} ${config_ref} ${group}"

NumSites=`wc -l stat_${config_eval}_${config_ref}_${group}_GPP_month.csv | sed -e "s/\([0-9]*\).*/\1/g"`
echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "month-to-month GPP variability" -o  gpp_month taylor_arrow_fluxnet_final_2.jnl "${NumSites} month $flag_reference_file GPP ${config_eval} ${config_ref} ${group}"

NumSites=`wc -l stat_${config_eval}_${config_ref}_${group}_GPP_year.csv | sed -e "s/\([0-9]*\).*/\1/g"`
echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "year-to-year GPP variability" -o  gpp_year taylor_arrow_fluxnet_final_2.jnl "${NumSites} year $flag_reference_file GPP ${config_eval} ${config_ref} ${group}"

NumSites=`wc -l stat_${config_eval}_${config_ref}_${group}_TER_hour.csv | sed -e "s/\([0-9]*\).*/\1/g"`
echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "hour-to-hour TER variability" -o  ter_hour taylor_arrow_fluxnet_final_2.jnl "${NumSites} hour $flag_reference_file TER ${config_eval} ${config_ref} ${group}"

