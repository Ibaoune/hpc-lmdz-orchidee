echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "day-to-day TER variability" -o  ter_day taylor_arrow_fluxnet_final_2.jnl "${NumSites} day $flag_reference_file TER ${config_eval} ${config_ref} ${group}"

