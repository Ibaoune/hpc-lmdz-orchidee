echo ${input} | ferretloop - ${debug} --ps2gif_option "-g $quality" -p -i "month-to-month TER variability" -o  ter_month taylor_arrow_fluxnet_final_2.jnl "${NumSites} month $flag_reference_file TER ${config_eval} ${config_ref} ${group}"

