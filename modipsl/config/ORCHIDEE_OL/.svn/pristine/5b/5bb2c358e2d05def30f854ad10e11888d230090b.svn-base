# To fill the VEGMAX for each site
# here below is the standard PFT list
#
#    1 - Bare soil
#    2 - tropical  broad-leaved evergreen
#    3 - tropical  broad-leaved raingreen
#    4 - temperate needleleaf   evergreen
#    5 - temperate broad-leaved evergreen
#    6 - temperate broad-leaved summergreen
#    7 - boreal    needleleaf   evergreen
#    8 - boreal    broad-leaved summergreen
#    9 - boreal    needleleaf   summergreen
#   10 -           C3           grass
#   11 -           C4           grass
#   12 -           C3           agriculture
#   13 -           C4           agriculture

[SPINUP]
# Initialisation for spin-up :
# orchidee with sechiba alone (!!! if ok_stomate == n !!!)
duree_nostomate=0
# orchidee with stomate
duree_inistomate=1
# teststomate (only if duree_inistomate > 0)
duree_offlineini=0

# Loop over ORCHIDEE runs (used for spin-up)
# The whole job is restarted n_iter times
n_iter=1
# orchidee with sechiba (and stomate if ok_stomate=y below)
duree_sechiba=500
# teststomate
duree_stomate=0
# forcesoil
duree_carbonsol=0

# Final run (full ORCHIDEE)
# This last parameter must be non-zero.
duree_final=1


    # POST configuration : 
    # --------------------
# Atlas Name : 
AtlasCfg=atlas_FLUXNET_V1.cfg

# Observation_file
observation_base_path=${R_BC}/OOL/${config_UserChoices_TagName}/FLUXNET


# History file of former ORCHIDEE runs (Reference) to compare with the current simulations
reference_base_path=/ccc/work/cont003/dsm/p86ghatt/IGCM_OUT/OL2/PROD/fluxnet.r2291
reference_config=TFlux7

# Modulo for SpinUp years
# by default, only one ATLAS-DIFF will be created 
# between the last step and the first one.
#Modulo=15


[UserChoices]
# stomate activated or not ?
ok_stomate=y
# Photosynthesis activated or not ?
ok_co2=y
# New hydrology (deRosnay) activated or not ?
ok_newhydrol=y
# Impose the vegetation
impose_veg=y
# No routing
ok_routing=n
SPINUP_ANALYTIC=y
land_use=n
# level of the history files for each iteration of the SPINUP
level_hist=0
# level of the history files for the final iteration of the SPINUP
level_hist_final=10

# DEBUG mode for SPINUP 
#
# This mode keep all SPINUP directory in ARCHIVE
# If disable, all ARCHIVE is automaticly cleaned.
DEBUG_SPIN=n
# If you don't want to keep old spinup steps, but last one
CONSERVE=n 

[SubJobParams]
# You can specify here any parameters to be modified in run.def
ALMA_OUTPUT=y
SECHIBA_reset_time=y
SPLIT_DT=1
SPINUP_PERIOD='${TIME_YEAR}'
SPINUP_ANALYTIC=y
NBUFF=0
STOMATE_FORCING_NAME=NONE
STOMATE_CFORCING_NAME=NONE
FIRE_DISABLE=y
# ATM_CO2=368 : value for year 2000
ATM_CO2=368
XIOS_ORCHIDEE_OK=n

