#
# This is config.card file for restart with an NEW libIGCM simulation tree.
#
#====================================================================================
#D-- Compatibility -
[Compatibility]
libIGCM=1.0

#========================================================================
#D-- UserChoices -
[UserChoices]
#============================
#-- Output will be stored in IGCM_OUT/TagName/SpaceName/ExperimentName/JobName
JobName=SpinUp
LongName="Spin Up for ORCHIDEE. See spinup.card for options."
TagName=OL2
#------ SpaceName = DEVT/TEST/PROD
SpaceName=PROD
#----- ExperimentName : Short Name of Experiment
ExperimentName=spinup
ARCHIVE=AUTO
#============================
#-- leap, noleap, 360d
CalendarType= gregorian
#-- Start and End of Job
#-- "YYYY-MM-DD"
DateBegin=1950-01-01
DateEnd=1950-12-31
#============================
#-- 1Y, 1M, 5D, 1D
PeriodLength= 1Y
PeriodNb= 1
#============================
#-- Total Number of Processors (minimum is 2 for a coupled configuration)
JobNumProcTot=2
#========================================================================
#========================================================================
#D-- SRF options passed to SuRFace (SECHIBA) subjobs
[SRF]
WriteFrequency="1M"
Restart=n
#-- Last day of the experience used as restart
RestartDate=1997-12-31
# Define restart simulation name
RestartJobName=SPINUP
RestartPath=${ARCHIVE}/${LOGIN}/IGCM_OUT/${config_UserChoices_TagName}
# Old component name for restart (if empty, use new name)
OldName=

#D-- Surface BioGeochemistry ( STOMATE ) subjobs
[SBG]
WriteFrequency= 1M
Restart= n
#-- Last day of the experience used as restart
RestartDate= 1900-12-31
# Define restart simulation name
RestartJobName= RESTART_SHILONG
RestartPath= /dmnfs11/cont003/p86manci/SHILONG_FORCAGES
# Old component name for restart (if empty, use new name)
OldName=

#D-- Post-treatment options passed to SubJobs
[SubJobPost]
#D- Do we archive the output text files and restart files?
#D- frequency to create the archives (by default RebuildFrequency)
PackFrequency=NONE
#D- Do we rebuild parallel output, this flag determines
#D- frequency of rebuild submission
RebuildFrequency=NONE
#D- Do we rebuild parallel output from archive (use NONE to use SCRATCHDIR as buffer)
RebuildFromArchive=NONE
#D- If you want to produce time series, this flag determines
#D- frequency of post-processing submission
TimeSeriesFrequency= NONE
#D- If you want to produce seasonal average, this flag determines
#D- the period of this average
SeasonalFrequency= NONE
#D- Offset for seasonal average first start dates ; same unit as SeasonalFrequency
#D- Usefull if you do not want to consider the first X simulation's years
SeasonalFrequencyOffset=0

#========================================================================
#========================================================================

#========================================================================
#D-- ListOfComponents - Don't modify this !
[ListOfComponents]
#D- For each component, Name of component, Tag of component
SPIN= (spinup, HEAD)

#========================================================================
#D-- Executable - Don't modify this !
[Executable]
#D- For each component, Real name of executable, Name of executable for oasis
SPIN= ("", SPIN, 1MPI)


#========================================================================
#D-- Post - Don't modify this !
[Post]
#D- Do we archive the output text files and restart files?
#D- frequency to create the archives (by default RebuildFrequency)
PackFrequency=NONE
#D- Do we rebuild parallel output, this flag determines
#D- frequency of rebuild submission
RebuildFrequency=NONE
#D- Do we rebuild parallel output from archive (use NONE to use SCRATCHDIR as buffer)
RebuildFromArchive=NONE
#D- If you want to produce time series, this flag determines
#D- frequency of post-processing submission
TimeSeriesFrequency= NONE
#D- If you want to produce seasonal average, this flag determines
#D- the period of this average
SeasonalFrequency= NONE
#D- Offset for seasonal average first start dates ; same unit as SeasonalFrequency
#D- Usefull if you do not want to consider the first X simulation's years
SeasonalFrequencyOffset=0

#========================================================================
#D-- Restarts - Don't modify this !
[Restarts]
#D- If you want a GENERAL RULE FOR RESTARTS, put this flag to 'y'
OverRule= n
#D- Last day of the experience used as restart
RestartDate=1979-12-31
#D- Define restart simulation name (=> JOB_OS)
RestartJobName=TESTFORCE
#D- Path Server Group Login (=> PSGL)
RestartPath=${ARCHIVE}/${LOGIN}/IGCM_OUT
# Attention login depend de la machine

#========================================================================
#D-- SPIN options : Don't modify this !
[SPIN]
WriteFrequency="1Y"
Restart=n
#-- Last day of the experience used as restart
RestartDate=
# Define restart simulation name
RestartJobName=
RestartPath=
# Old component name for restart (if empty, use new name)
OldName=

#========================================================================
